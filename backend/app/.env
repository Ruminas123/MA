# Server Configuration
NODE_ENV=development
PORT=2000
REQUEST_TIMEOUT=120000

# Authentication
JWT_SECRET=your-very-secure-secret-key-here
JWT_EXPIRES_IN=24h

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ma_project
DB_USER=postgres
DB_PASSWORD=abc@1234

# Performance Tuning
ENABLE_CLUSTERING=false
MAX_WORKERS=4
BATCH_SIZE=50
MAX_CONCURRENT_PINGS=100
PING_TIMEOUT=2